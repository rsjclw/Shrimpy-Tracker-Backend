# PostgreSQL connection
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# (when running via docker compose this is overridden to point at the `db` container)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE

# Secret used to sign login tokens (HS256). Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
# How long a login token stays valid (hours). Default 168 = 7 days.
JWT_EXPIRES_HOURS=168

# CORS (Next.js dev origin)
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated account emails with global admin access
ADMIN_EMAILS=rasyidfajar01@gmail.com
